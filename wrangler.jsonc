// Einstellungen für Cloudflare: liefert den fertigen Ordner _site als Website aus
{
  "name": "hirwa-homepage",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  // Nötig, damit Cloudflare für Testzweige eine Vorschau-Adresse baut
  "previews": {}
}
